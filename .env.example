# 复制本文件为 .env.local 并填入你的配置

# 必填：OpenRouter API Key（https://openrouter.ai/keys）
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：本机无法直连 openrouter.ai 时走本地代理（Clash/V2Ray 等），如 http://127.0.0.1:7890
# PROXY_URL=

# 可选：自定义 OpenRouter 兼容中转地址（默认官方 https://openrouter.ai/api/v1）
# OPENROUTER_BASE_URL=
